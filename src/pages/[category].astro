---
import Base from '../layouts/Base.astro';
import EntryRow from '../components/EntryRow.astro';
import { loadEntries, CATEGORIES, fmtDate } from '../lib';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const all = await loadEntries();
const entries = all.filter((e) => e.category === cat.slug);
const checked = fmtDate(new Date('2026-08-26'));
const descriptions: Record<string, string> = {
  design: 'Detectors, tell catalogs, and reference archives that keep AI slop out of visual and product design.',
  copy: 'Field guides and standards for AI prose: what to read, what to join, and what the detectors get wrong.',
  code: 'The accountability standards for AI-assisted code, from the people who maintain real infrastructure.',
  images: 'Provenance standards and artists’ tools against generated-image slop.',
  meta: 'The journalists, critics, and quiet corners keeping the human internet legible.',
};
---
<Base
  title={`${cat.label} · Stop the Slop`}
  description={descriptions[cat.slug]}
  current={cat.slug}
>
  <section class="hero cat-hero" style={`--band:${cat.color};--band-text:${cat.text}`}>
    <div class="wrap">
      <h1 class="display">{cat.label}<span class="dot">.</span></h1>
      <p class="dek">{descriptions[cat.slug]}</p>
      <p class="meta">{entries.length} {entries.length === 1 ? 'entry' : 'entries'} · links checked {checked}</p>
    </div>
  </section>
  <div class="wrap">
    <div class="grid">
      {entries.map((entry) => <EntryRow entry={entry} />)}
    </div>
  </div>
</Base>
