---
import Base from '../layouts/Base.astro';
import EntryRow from '../components/EntryRow.astro';
import { loadEntries, CATEGORIES, fmtDate } from '../lib';

const entries = await loadEntries();
const checked = fmtDate(new Date('2026-08-26'));
---
<Base
  title="Stop the Slop: a library of everything fighting AI slop"
  description="The internet is filling up with beige goo. This is a working library of the tools, guides, and standards that keep AI slop out of design, writing, code, and images."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="display">Stop the<br />Slop<span class="dot">.</span></h1>
        <p class="dek">
          The internet is filling up with beige goo. This is a working library of the
          tools, guides, and standards that keep AI slop out of design, writing, code,
          and images. Collected and kept current by people who make things.
        </p>
        <p class="meta">{entries.length} entries · every link checked {checked}</p>
      </div>
      <figure class="hero-blob" aria-hidden="true">
        <img src="/slop.webp" alt="" width="900" height="900" loading="eager" />
      </figure>
    </div>
  </section>

  {CATEGORIES.map((cat) => {
    const catEntries = entries.filter((e) => e.category === cat.slug);
    if (catEntries.length === 0) return null;
    return (
      <section class="cat" aria-labelledby={`cat-${cat.slug}`}>
        <header class="cat-band" style={`--band:${cat.color};--band-text:${cat.text}`}>
          <div class="wrap cat-head">
            <h2 class="display" id={`cat-${cat.slug}`}><a href={`/${cat.slug}/`}>{cat.label}</a></h2>
            <span class="count">{catEntries.length} {catEntries.length === 1 ? 'entry' : 'entries'}</span>
          </div>
        </header>
        <div class="wrap">
          <div class="card">
            {catEntries.map((entry) => <EntryRow entry={entry} />)}
          </div>
        </div>
      </section>
    );
  })}
</Base>
