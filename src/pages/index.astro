---
import Base from '../layouts/Base.astro';
import EntryRow from '../components/EntryRow.astro';
import { loadEntries, CATEGORIES, VERDICTS, fmtDate } from '../lib';

const entries = await loadEntries();
const checked = fmtDate(new Date('2026-08-26'));
---
<Base
  title="Stop the Slop: tools, guides, and standards for work that doesn't look AI-generated"
  description="A big, opinionated list of the tools, guides, and standards that keep AI slop out of design, writing, code, and images. A person read every one and gave it a straight verdict: GO, CAUTION, or STOP."
>
  <section class="hero">
    <div class="wrap">
      <h1 class="display">Stop the<br />Slop<span class="dot">.</span></h1>
      <p class="dek">
        A big, opinionated list of the tools, guides, and standards that keep AI slop out
        of design, writing, code, and images. A person read every one and gave it a
        straight verdict.
      </p>
      <dl class="pills">
        {Object.entries(VERDICTS).map(([key, v]) => (
          <div class="pill-row">
            <dt><span class={`verdict verdict-${key}`}>{v.label}</span></dt>
            <dd>{v.gloss}</dd>
          </div>
        ))}
      </dl>
      <p class="meta">{entries.length} entries · all links checked {checked}</p>
    </div>
  </section>

  {CATEGORIES.map((cat) => {
    const catEntries = entries.filter((e) => e.category === cat.slug);
    if (catEntries.length === 0) return null;
    return (
      <section class="cat" aria-labelledby={`cat-${cat.slug}`}>
        <div class="wrap">
          <header class="cat-head">
            <h2 class="display" id={`cat-${cat.slug}`}><a href={`/${cat.slug}/`}>{cat.label}</a></h2>
            <span class="count">{catEntries.length} {catEntries.length === 1 ? 'entry' : 'entries'}</span>
          </header>
          <div class="card">
            {catEntries.map((entry) => <EntryRow entry={entry} />)}
          </div>
        </div>
      </section>
    );
  })}
</Base>
